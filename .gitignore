# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
# Local tooling artifacts / secrets
.claude/review-history.jsonl
.claude/settings.local.json
.env
# Runtime data (host-native): sqlite, audit log, memory, workspace, screenshots
/data/
# Self-edit rollback marker — runtime state, survives restart, never committed.
/.selfedit-pending.json
# Secrets — keep dir structure, never the real secret files
/secrets/*
!/secrets/README.md
# Local sqlite databases
*.db
.aider*
# Local backups — memory dumps + .claude credential backups, never publish
/backups/

# Install-local config (seeded from config.default.yaml by the wizard).
/config.yaml
