# chief core image. The Agent SDK shells out to the `claude` CLI, so the image carries
# the Node-based Claude Code CLI alongside the Python package (proven in s0/Dockerfile).
FROM python:3.12-slim-bookworm

# Node runtime + the Claude Code CLI the SDK invokes (`shutil.which("claude")`), plus
# git for the memory versioner (GitVersioner shells out to `git` when memory_git=true).
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm git \
    && npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# uv for the Python dependency install.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
# Install deps + the chief package from the locked resolution (src/ needed for the build).
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
RUN uv sync --no-dev --frozen

# Non-secret runtime config; secrets arrive as a Docker secret mount at /run/secrets.
COPY config.yaml ./

# Bundled skills plugin (M10). Submodule content must be checked out in the build
# context (`git submodule update --init`) for owner sessions to load skills.
COPY vendor/ ./vendor/

# Put the project venv on PATH so the CMD runs without re-resolving at startup.
ENV PATH="/app/.venv/bin:$PATH"

CMD ["python", "-m", "chief.app"]
