# chief core image. The Agent SDK shells out to the `claude` CLI, so the image carries
# the Node-based Claude Code CLI alongside the Python package (proven in s0/Dockerfile).
FROM python:3.12-slim-bookworm

# Node runtime + the Claude Code CLI the SDK invokes (`shutil.which("claude")`), plus
# git for the memory versioner (GitVersioner shells out to `git` when memory_git=true).
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm git \
    && npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# uv for the Python dependency install.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
# Install deps + the chief package from the locked resolution (src/ needed for the build).
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
RUN uv sync --no-dev --frozen

# Non-secret runtime config; secrets arrive as a Docker secret mount at /run/secrets.
COPY config.yaml ./

# Bundled skills plugin (M10). Submodule content must be checked out in the build
# context (`git submodule update --init`) for owner sessions to load skills.
COPY vendor/ ./vendor/
# Fail loudly if the skills submodule wasn't checked out. An empty or partial upstream/
# would otherwise COPY clean and silently ship a plugin missing skills. We assert each
# upstream dir plugin.json references exists — keep this list in sync with the manifest.
RUN set -e; \
    for s in docx pdf pptx xlsx doc-coauthoring internal-comms claude-api skill-creator mcp-builder; do \
        test -d "vendor/chief-skills/upstream/skills/$s" \
        || { echo "vendor/chief-skills/upstream/skills/$s missing — run 'git submodule update --init' before docker build" >&2; exit 1; }; \
    done

# Non-root user (uid/gid 1000) — matches the MCP services and sandbox pattern.
# Pre-create and chown every named-volume mountpoint so Docker initialises freshly-created
# volumes with the correct ownership (Docker copies image perms into an empty volume on
# first mount). The claude CLI writes session transcripts under $HOME/.claude; pointing
# HOME at /home/chief keeps that traffic on the claude-home volume, not /root.
RUN useradd --create-home --uid 1000 chief \
    && mkdir -p /data /memory /workspace /home/chief/.claude \
    && chown -R chief:chief /data /memory /workspace /home/chief

# Put the project venv on PATH so the CMD runs without re-resolving at startup.
ENV PATH="/app/.venv/bin:$PATH"
ENV HOME="/home/chief"

# Container stdout is a pipe, so Python block-buffers it and the JSON log
# stream stalls in the 8KB buffer (invisible to `docker logs`) until it fills.
# Unbuffered stdout makes every log line flush immediately.
ENV PYTHONUNBUFFERED=1

# Migrate-on-start (M13): run alembic upgrade head before the app boots.
# chief.entrypoint is fail-loud: non-zero exit + clear log on migration failure,
# so the app never starts on a half-migrated schema.
# DB_PATH mirrors the sqlite-data volume mount in docker-compose.yml.
ENV DB_PATH="/data/chief.db"

USER chief
ENTRYPOINT ["python", "-m", "chief.entrypoint"]
