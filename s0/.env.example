# S0 secrets — copy to s0/.env (gitignored) and fill in. Never commit real values.

# Mint with `claude setup-token` (1-year OAuth token; runs the SDK on your Max plan).
CLAUDE_CODE_OAUTH_TOKEN=

# Only needed for the Telegram round-trip (S0b).
# Bot token from @BotFather:
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot):
OWNER_TELEGRAM_ID=

# Do NOT set ANTHROPIC_API_KEY — it outranks the OAuth token and bills the API.
